# Скопируйте в .env и задайте свой токен.
# Токен обязателен: пустое значение открывает доступ без пароля.
JUPYTER_TOKEN=смените-меня-на-длинную-случайную-строку

# Порт на машине, с которого будет виден Jupyter.
JUPYTER_PORT=8888

# Пути к данным и моделям на машине. По умолчанию берутся из репозитория.
DATA_PATH=../data
MODELS_PATH=../models
